{
  "id": "strata",
  "name": "Strata",
  "kind": "fixed_model",
  "url": "https://github.com/Niko1221/Strata",
  "evidence": "documented",
  "upstream": {
    "github": "Niko1221/Strata",
    "version": "0.2.13",
    "released_at": "2026-11-09",
    "status": "active"
  },
  "checked_at": "2026-11-11",
  "sources": [
    "https://github.com/Niko1221/Strata/blob/main/docs/MODELS.md",
    "https://github.com/Niko1221/Strata/blob/main/docs/INSTALL.md",
    "https://github.com/Niko1221/Strata/blob/main/docs/DETAILS.md",
    "https://github.com/Niko1221/Strata/blob/main/docs/DEEPSEEK41.md",
    "https://github.com/Niko1221/Strata/blob/main/docs/OLDER_GPUS.md",
    "https://github.com/Niko1221/Strata/blob/main/docs/AMD_HIP.md",
    "https://huggingface.co/ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF",
    "https://huggingface.co/agentionai/Qwen3.8-Flash-Next-Gyro-GGUF"
  ],
  "platforms": [
    {
      "os": ["linux", "windows"],
      "accel": "cuda",
      "min_compute_capability": "7.5",
      "note": "RTX 20 and newer; Pascal and Volta run an experimental CUDA 12 engine"
    },
    {
      "os": ["linux", "windows"],
      "accel": "rocm",
      "note": "RX 6000 to 9000, Radeon AI PRO R9700 and Strix Halo"
    },
    {
      "os": ["linux"],
      "accel": "sycl",
      "note": "Intel Arc"
    },
    {
      "os": ["darwin"],
      "accel": "metal",
      "note": "Apple Silicon, macOS 15 or newer"
    }
  ],
  "memory": ["gpu", "expert_offload"],
  "serve": "strata launch",
  "port": 8080,
  "api": ["openai", "anthropic"],
  "install": {
    "docs": "https://github.com/Niko1221/Strata/blob/main/docs/INSTALL.md",
    "linux": "curl -fsSL https://github.com/Niko1221/Strata/releases/latest/download/install.sh -o install.sh && sh install.sh",
    "darwin": "curl -fsSL https://github.com/Niko1221/Strata/releases/latest/download/install.sh -o install.sh && sh install.sh",
    "windows": "irm https://github.com/Niko1221/Strata/releases/latest/download/install.ps1 | iex"
  },
  "detect_binaries": ["strata"],
  "detect_paths": {
    "linux": ["~/.local/bin/strata", "~/.local/share/strata/components"],
    "darwin": ["~/.local/bin/strata"],
    "windows": ["%LOCALAPPDATA%\\Strata\\components"]
  },
  "version_args": ["--version"],
  "models": [
    {
      "id": "qwen3.8-flash-next",
      "name": "Qwen3.8-Flash-Next",
      "base": "Qwen/Qwen3.8-Flash-Next",
      "note": "Experts go to RAM and the 29 GB n-gram table stays on the SSD, so RAM needs the experts plus about 10 GB. The download adds a 6 GB draft layer on first start.",
