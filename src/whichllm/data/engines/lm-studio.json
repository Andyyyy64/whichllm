    },
    {"os": ["linux", "windows"], "accel": "cpu", "requires_avx2": true}
  ],
  "gguf": {},
  "memory": ["gpu", "layer_offload", "expert_offload", "cpu"],
  "serve": "lms server start --port 1234",
  "port": 1234,
  "api": ["openai", "anthropic"],
  "install": {
    "docs": "https://lmstudio.ai/download"
  },
  "detect_binaries": ["lms"]
