          "id": "q2_0",
          "name": "ISTA-DASLab Q2_0",
          "repo": "ISTA-DASLab/Qwen3.8-Flash-Next-GSQ-RCO-GGUF",
          "quant": "Q2_0",
          "launch": "strata launch --family qwen --model q2_0",
          "docs_speed": {"tok_per_sec": 94, "hardware": "RTX 5070 12 GB, Ryzen 5 7600, 64 GB RAM"},
