{
  "id": "lm-studio",
  "name": "LM Studio",
  "kind": "runner",
  "url": "https://lmstudio.ai",
  "evidence": "community",
  "upstream": {
    "version": "0.4.28",
    "status": "active"
  },
  "checked_at": "2026-11-04",
  "sources": [
    "https://lmstudio.ai/download",
    "https://lmstudio.ai/docs/app/system-requirements",
    "https://lmstudio.ai/changelog/lmstudio-v0.4.1",
    "https://lmstudio.ai/docs/developer",
    "https://github.com/lmstudio-ai/mlx-engine"
